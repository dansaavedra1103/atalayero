# What `make up` writes to .env (docker/local_env.py; never commit .env): host settings and local
# secrets for Docker Compose (ADR-0021, ADR-0022). Missing values are added; none is ever changed.
AIRFLOW_UID=1000                       # your user ID (`id -u`): files Airflow writes stay yours
ATALAYERO_ROOT=/path/to/atalayero      # the repository, mounted at the same path in Airflow
AIRFLOW_POSTGRES_PASSWORD=change-me    # Airflow's metadata database
AIRFLOW_JWT_SECRET=change-me           # signs Airflow's API tokens
AIRFLOW_FERNET_KEY=change-me           # encrypts Airflow connections: 32 url-safe base64 bytes
ATALAYERO_API_KEY=change-me            # what a local client sends in X-API-Key
ATALAYERO_API_KEY_SHA256=change-me     # its SHA-256: all the API is told
